              }
            ],
            "url": "{{baseUrl}}/remittances/{{remittanceReference}}",
            "description": ""
          }
        },
        {
          "name": "Get outbound provider quotes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/outbound-remittances/quotes",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccount\": \"{{accountNumber}}\",\n  \"sourceAmountMinor\": 10000000,\n  \"destinationCurrency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 && pm.response.json().length > 0) { pm.environment.set(\"providerQuoteId\", pm.response.json()[0].quoteId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Send outbound remittance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/outbound-remittances",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{providerQuoteId}}\",\n  \"beneficiaryName\": \"Demo Beneficiary\",\n  \"beneficiaryAccount\": \"US-ACCOUNT-123\",\n  \"beneficiaryBank\": \"Demo Bank\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
