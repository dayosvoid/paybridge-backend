          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/kyc/account-details?accountNumber=0123456789&bankCode=058",
            "description": ""
          }
        }
      ]
    }
