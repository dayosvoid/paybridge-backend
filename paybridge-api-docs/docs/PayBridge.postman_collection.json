  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"fullName\": \"Demo Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "After a successful response, save accessToken, refreshToken, and user.accountNumber into the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"accessToken\", data.accessToken);",
                  "  pm.environment.set(\"refreshToken\", data.refreshToken);",
                  "  pm.environment.set(\"accountNumber\", data.user.accountNumber);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout refresh-token family",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout all sessions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout-all",
            "description": ""
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "02 Accounts and statements",
      "item": [
        {
          "name": "Open account (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/accounts",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 123,\n  \"accountName\": \"Ops Test\",\n  \"bankCode\": \"058\",\n  \"bankName\": \"Demo Bank\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get NGN balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountNumber}}?currency=NGN",
            "description": ""
          }
        },
        {
          "name": "Get all currency balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountNumber}}/balances",
            "description": ""
          }
        },
        {
          "name": "Change account status (ADMIN only)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountNumber}}/status",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Statement",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/accounts/{{accountNumber}}/transactions?currency=NGN&page=0&size=20",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "03 Transfers and reconciliation",
      "item": [
        {
          "name": "Create internal transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/transfers",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccount\": \"{{accountNumber}}\",\n  \"destinationAccount\": \"{{destinationAccount}}\",\n  \"amountMinor\": 25000,\n  \"currency\": \"NGN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.environment.set(\"transferReference\", pm.response.json().reference); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transfer by reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/transfers/{{transferReference}}",
            "description": ""
          }
        },
        {
          "name": "List transfers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/transfers?account={{accountNumber}}&status=PENDING&page=0&size=20",
            "description": ""
          }
        },
        {
          "name": "Paystack webhook (must sign exact raw bytes)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-paystack-signature",
                "value": "{{paystackSignature}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/paystack",
            "description": "Placeholder signature will not validate. Generate HMAC-SHA512 over the exact raw body using the configured Paystack secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"transfer.success\",\n  \"data\": {\n    \"reference\": \"{{transferReference}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Run reconciliation (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/admin/reconciliation/run?minAgeSeconds=0&batchSize=50",
            "description": ""
          }
        }
      ]
    },
    {
