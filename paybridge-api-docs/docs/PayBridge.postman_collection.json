    {
      "name": "06 Signed remittance webhooks",
      "item": [
        {
          "name": "Inbound payment webhook (signature is canonical fields)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Signature",
                "value": "{{remittanceSignature}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/remittance/inbound",
            "description": "Placeholder signature will not validate. Sign providerReference|accountNumber|amountMinor|currency using HMAC-SHA256 and the configured remittance webhook secret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerReference\": \"local-in-001\",\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amountMinor\": 500000,\n  \"currency\": \"USD\",\n  \"senderName\": \"Example Sender\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inbound reversal webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Signature",
                "value": "{{remittanceSignature}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/remittance/inbound/reversal",
            "description": "Sign reversal|providerReference with HMAC-SHA256; placeholder signature will not validate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerReference\": \"local-in-001\",\n  \"reason\": \"Local reversal test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Outbound returned webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Signature",
                "value": "{{remittanceSignature}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/webhooks/remittance/outbound/returned",
            "description": "Sign returned|reference with HMAC-SHA256; placeholder signature will not validate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"{{outboundReference}}\",\n  \"reason\": \"Local return test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
