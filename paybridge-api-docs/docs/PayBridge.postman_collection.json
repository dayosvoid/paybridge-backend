            "url": "{{baseUrl}}/fx/quote?source=NGN&destination=USD&amountMinor=10000000",
            "description": ""
          }
        },
        {
          "name": "Create conversion quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/fx/conversions/quotes",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"sourceCurrency\": \"NGN\",\n  \"destinationCurrency\": \"USD\",\n  \"sourceAmountMinor\": 10000000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.environment.set(\"conversionQuoteId\", pm.response.json().quoteId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute conversion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/fx/conversions",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{conversionQuoteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get conversion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/fx/conversions/{{conversionReference}}",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "05 Remittance",
      "item": [
        {
          "name": "Create direct remittance",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/remittances",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccount\": \"{{accountNumber}}\",\n  \"beneficiaryAccount\": \"US-BENEFICIARY-001\",\n  \"sourceAmountMinor\": 10000000,\n  \"sourceCurrency\": \"NGN\",\n  \"destinationCurrency\": \"USD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get direct remittance",
          "request": {
            "method": "GET",
